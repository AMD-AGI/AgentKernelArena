  "contracts": [
    {
      "value": "MLA absorbed decode, split-KV stage 1: for each (batch b, q-head h, kv split s) over the paged latent KV named by kv_indices[kv_indptr[b]:kv_indptr[b+1]] (page_size=1), qk = Q[b,h,:576] . K[idx,0,:576] * sm_scale ; att_out[b,h,s,:512] = softmax_partial(qk) @ K[idx,0,:512]  (HAS_MLA: V is the leading 512 lanes of the same latent row, v = trans(k)) ; att_lse[b,h,s] = max(qk) + log(sum exp(qk-max)). Slots s >= num_kv_splits[b] are not written by the kernel and are compared as zero on both sides.",
      "evidence": "ut/meta.json#/math_contract"
    }
  ],
